{
  "name": "wilma-api",
  "version": "0.1.0",
  "description": "Pure TypeScript library for Wilma school information system API interaction and parsing",
  "keywords": [
    "wilma",
    "school",
    "api",
    "parser",
    "ouka",
    "inschool"
  ],
  "homepage": "https://github.com/jarihu/wilma-api-scraper/#readme",
  "bugs": {
    "url": "https://github.com/jarihu/wilma-api-scraper/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jarihu/wilma-api-scraper.git"
  },
  "license": "MIT",
  "author": "https://github.com/jarihu",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "directories": {
    "doc": "docs",
    "test": "test"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "axios": "^1.13.2",
    "axios-cookiejar-support": "^6.0.5",
    "cheerio": "^1.1.2",
    "date-fns": "^3.6.0",
    "tough-cookie": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/tough-cookie": "^4.0.5",
    "@typescript-eslint/eslint-plugin": "^8.49.0",
    "@typescript-eslint/parser": "^8.49.0",
    "eslint": "^9.39.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^7.2.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  }
}
